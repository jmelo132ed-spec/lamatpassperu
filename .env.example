USE_MOCK=true
PUBLIC_API_URL=

# ------------------------------------------------------------
# 1) LINK PERÚ
# Gente CON IP de Perú: al hacer clic en Reservar boletos
# (fotos, botones y cards) van a este link.
# Ejemplo: https://tu-pagina.com/checkout
# ------------------------------------------------------------
PUBLIC_TICKETS_URL=/reservar

# ------------------------------------------------------------
# 2) LINK FUERA DE PERÚ
# Gente CON IP de otro país: al entrar se redirige sola aquí.
# Si lo dejas vacío, no se aplica el filtro.
# Ejemplo: https://www.latamairlines.com
# ------------------------------------------------------------
PUBLIC_FOREIGN_REDIRECT_URL=

# Solo para probar el filtro en local (PE o US). Déjalo vacío en Vercel.
PUBLIC_FORCE_COUNTRY=

