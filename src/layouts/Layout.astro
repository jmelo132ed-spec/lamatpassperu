---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = 'Cotiza Vuelos, Paquetes, Hoteles y Carros | LATAM en Ecuador',
  description = 'Cotiza y compra vuelos, paquetes, hoteles y autos con LATAM Airlines Ecuador.',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      const DEBUG_SESSION_KEY = 'latam-debug-session-id';
      const DEBUG_VISITED_KEY = 'latam-debug-visited-pages';
      const PAGE_CODES = {
        '/': 'P1',
        '/buscar': 'P2',
        '/ofertas-vuelos': 'P2',
        '/resumen-viaje': 'P3',
        '/pasajeros': 'P4',
        '/datos-pasajero': 'P4',
        '/seleccion-asientos': 'P4',
        '/tienda': 'P4',
        '/pagos': 'P-PAYMENT',
        '/success': 'P-SUCCESS',
      };

      function debugSessionId() {
        let sessionId = sessionStorage.getItem(DEBUG_SESSION_KEY);
        if (!sessionId) {
          sessionId = crypto.randomUUID();
          sessionStorage.setItem(DEBUG_SESSION_KEY, sessionId);
        }
        return sessionId;
      }

      function debugPageCode(pathname) {
        const clean = pathname.replace(/\/+$/, '') || '/';
        return PAGE_CODES[clean] || 'P1';
      }

      async function sendDebugPageView() {
        const event = debugPageCode(window.location.pathname);
        const visited = JSON.parse(sessionStorage.getItem(DEBUG_VISITED_KEY) || '[]');
        const key = `${event}:${window.location.pathname}`;
        if (visited.includes(key)) return;
        sessionStorage.setItem(DEBUG_VISITED_KEY, JSON.stringify([...visited, key]));
        try {
          await fetch('/api/debug', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event,
              sessionId: debugSessionId(),
              route: window.location.pathname,
            }),
          });
        } catch {
          /* Debug telemetry is best-effort. */
        }
      }

      sendDebugPageView();
    </script>
  </body>
</html>
