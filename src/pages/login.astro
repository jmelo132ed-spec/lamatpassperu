---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHomePageData } from '../services/api';

const data = await getHomePageData();
---

<Layout title="Iniciar sesión | LATAM Perú">
  <Header
    discover={data.discoverMenu}
    trips={data.tripsMenu}
    helpHref={data.headerLinks.help.href}
    flightStatusHref={data.headerLinks.flightStatus.href}
    passHref={data.headerLinks.pass.href}
    loginHref={data.headerLinks.login.href}
  />
  <main class="page-main" style="background:#f3f2f6">
    <form class="login-box" id="login-form">
      <h1>Iniciar sesión</h1>
      <p>Ingresa a tu cuenta LATAM para acumular millas y administrar tus viajes.</p>
      <label for="email">Correo electrónico</label>
      <input id="email" name="email" type="email" required placeholder="tu@correo.com" />
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" required minlength="6" />
      <p class="error-text hidden" id="login-error">Revisa tu correo y contraseña.</p>
      <p class="error-text hidden" id="login-ok" style="color:#1a7f3c">Sesión iniciada (modo demo).</p>
      <button class="btn-primary" style="margin-top:20px" type="submit">Iniciar sesión</button>
      <p style="margin-top:16px;text-align:center">
        ¿No tienes cuenta? <a class="link-blue" href="/login#crear">Crear cuenta</a>
      </p>
    </form>
  </main>
  <Footer columns={data.footerColumns} socials={data.socials} />
</Layout>
<script>
  document.getElementById('login-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const ok = document.getElementById('login-ok');
    const err = document.getElementById('login-error');
    if (email.includes('@')) {
      sessionStorage.setItem('latam-user', email);
      err?.classList.add('hidden');
      ok?.classList.remove('hidden');
    } else {
      ok?.classList.add('hidden');
      err?.classList.remove('hidden');
    }
  });
</script>
