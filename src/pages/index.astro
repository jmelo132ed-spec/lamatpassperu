---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingBenefits from '../components/landing/LandingBenefits.astro';
import LandingDestinations from '../components/landing/LandingDestinations.astro';
import LandingSteps from '../components/landing/LandingSteps.astro';
import LandingCta from '../components/landing/LandingCta.astro';
import LandingStickyBar from '../components/landing/LandingStickyBar.astro';
import LandingGeoGate from '../components/landing/LandingGeoGate.astro';
import { getLandingPageData } from '../services/api';
import { getForeignRedirectUrl, getRequestCountry } from '../lib/geoRedirect';

const data = await getLandingPageData();
const { landing, ticketsHref } = data;
const foreignUrl = getForeignRedirectUrl();
const country = getRequestCountry(Astro.request);
---

<Layout title={data.config.title} description={data.config.description}>
  <LandingGeoGate foreignUrl={foreignUrl} country={country} />
  <Header
    discover={data.discoverMenu}
    trips={data.tripsMenu}
    helpHref={data.headerLinks.help.href}
    flightStatusHref={data.headerLinks.flightStatus.href}
    passHref={data.headerLinks.pass.href}
    loginHref={data.headerLinks.login.href}
  />
  <main>
    <LandingHero
      badge={landing.hero.badge}
      discount={landing.hero.discount}
      kicker={landing.hero.kicker}
      title={landing.hero.title}
      text={landing.hero.text}
      primaryCta={landing.hero.primaryCta}
      image={landing.hero.image}
      imageAlt={landing.hero.imageAlt}
      ticketsHref={ticketsHref}
    />
    <LandingBenefits benefits={landing.benefits} />
    <LandingDestinations
      nationalTitle={landing.nationalTitle}
      nationalLead={landing.nationalLead}
      internationalTitle={landing.internationalTitle}
      internationalLead={landing.internationalLead}
      national={landing.national}
      international={landing.international}
      ticketsHref={ticketsHref}
      ctaLabel={landing.hero.primaryCta}
    />
    <LandingSteps steps={landing.steps} />
    <LandingCta
      title={landing.finalCta.title}
      text={landing.finalCta.text}
      primaryCta={landing.finalCta.primaryCta}
      image={landing.finalCta.image}
      ticketsHref={ticketsHref}
    />
  </main>
  <LandingStickyBar href={ticketsHref} label={landing.hero.primaryCta} />
  <Footer columns={data.footerColumns} socials={data.socials} />
  <CookieBanner {...data.cookieBanner} />
</Layout>

<style is:global>
  body:has(.landing-sticky) {
    padding-bottom: 72px;
  }
</style>
