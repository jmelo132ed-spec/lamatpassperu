---
interface Dest { rank: number; city: string; image: string; href: string }
interface Props { destinations: Dest[] }
const { destinations } = Astro.props;
---

<section class="section">
  <div class="container-latam">
    <h2>Destinos más buscados</h2>
    <p>Descubre los 4 destinos más buscados</p>
    <div class="dest-grid" style="margin-top:24px">
      {destinations.map((d) => (
        <a class="dest-card" href={d.href} style={`background-image:linear-gradient(rgba(0,0,0,0) 49.42%, rgb(16,0,79) 100%), url('${d.image}')`}>
          <div>
            <small>#{d.rank}</small>
            <h3 style="margin:0;font-size:22px">{d.city}</h3>
          </div>
        </a>
      ))}
    </div>
    <p style="margin-top:16px"><a class="link-blue" href="/destinos">Ir a Destinos</a></p>
  </div>
</section>
