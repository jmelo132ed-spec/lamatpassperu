---
interface Props {
  fromCity: string;
  fromCode: string;
  toCity: string;
  toCode: string;
  datesLabel: string;
  paxLabel: string;
  cabin: string;
  tripLabel: string;
  passengers?: number;
  startOpen?: boolean;
}

const {
  fromCity,
  toCity,
  datesLabel,
  paxLabel,
  cabin,
  passengers,
  startOpen = false,
} = Astro.props;

const datesText = datesLabel.replace(/\.\s*-\s*/g, ' - ').replace(/\.$/, '');
const compactDatesText = datesText.replace(/\s-\s/g, ' a ');
const parsedPax = Number.parseInt(paxLabel, 10);
const paxCount = typeof passengers === 'number' ? passengers : (Number.isFinite(parsedPax) ? parsedPax : 1);
const paxText = `${paxCount} ${paxCount === 1 ? 'Pasajero' : 'Pasajeros'}`;
