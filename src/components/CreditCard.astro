---
interface Props { title: string; cta: string; image: string; href: string }
const { title, cta, image, href } = Astro.props;
---

<section class="section credit-section">
  <div class="container-latam">
    <a class="credit" href={href} target="_blank" rel="noopener noreferrer">
      <span class="credit__sr">{title} Al seleccionar este banner serás redirigido a un formulario para solicitar tu tarjeta LATAM Pass.</span>
      <div class="credit__inner">
        <img src={image} alt="" width="214" height="224" />
        <div class="credit__copy">
          <p class="credit__title">Pide tu Tarjeta LATAM Pass Banco de Crédito y <strong>obtén hasta 6.000 millas</strong></p>
          <span class="credit__cta">
            {cta}<span class="credit__sr">Se abrirá en una nueva ventana</span>
            <i aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32" width="12" height="12">
                <path d="M29.3337 2.375V13.575H26.667V7.10701L13.8403 20.575L12.0003 18.643L24.827 5.175H18.667V2.375H29.3337ZM13.3337 2.375V5.175H5.33366V27.575H26.667V19.175H29.3337V30.375H2.66699V2.375H13.3337Z" fill="currentColor"></path>
              </svg>
            </i>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
