    seats: `<svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M2.44139 5.10565C2.60441 5.04844 2.75117 5.06478 2.89789 5.14651C3.04461 5.22824 3.14212 5.34266 3.19917 5.50611L8.79105 23.805C9.02743 24.6305 9.34524 25.3088 9.72834 25.8237C10.1114 26.3468 10.5599 26.739 11.0652 27.0088C11.2771 27.115 11.5216 27.2049 11.7824 27.2703C12.0514 27.3357 12.3284 27.3684 12.6218 27.3684C13.2087 27.3684 13.9179 27.2213 14.7575 26.927C15.597 26.6328 16.2656 26.3958 16.7709 26.2078C17.2763 26.0199 17.5694 25.9136 17.6509 25.8891C17.7324 25.8646 17.8469 25.8728 18.0099 25.93C18.1729 26.0117 18.2788 26.1261 18.3522 26.2895C18.4174 26.453 18.4255 26.6083 18.3685 26.7718C18.344 26.8535 18.2952 26.9189 18.23 26.9679C18.1648 27.0251 18.0914 27.0578 18.0099 27.0905C17.7735 27.1722 17.5207 27.2621 17.2517 27.3684C16.7463 27.5563 16.0371 27.8097 15.116 28.1284C14.195 28.4472 13.3801 28.6106 12.6628 28.6106C12.2634 28.6106 11.8804 28.5698 11.5217 28.488C11.1631 28.4063 10.8207 28.2919 10.5028 28.1284C9.83446 27.7852 9.25544 27.2785 8.76638 26.6246C8.27732 25.9708 7.87816 25.1535 7.58472 24.1646L2.03383 5.86572C1.97678 5.70226 1.99292 5.55515 2.07443 5.40804C2.16409 5.26093 2.28652 5.16286 2.44139 5.10565ZM12.9887 6.11092C12.9887 6.85464 12.7198 7.50845 12.19 8.05602C11.6601 8.6036 11.0081 8.8733 10.2338 8.8733C9.45945 8.8733 8.79908 8.6036 8.25296 8.05602C7.70684 7.50845 7.43786 6.86282 7.43786 6.11092C7.43786 5.3345 7.70684 4.67249 8.25296 4.12491C8.79908 3.57733 9.45945 3.30763 10.2338 3.30763C11.0081 3.30763 11.6601 3.5855 12.19 4.12491C12.7198 4.67249 12.9887 5.3345 12.9887 6.11092ZM11.7498 6.11092C11.7498 5.68593 11.603 5.31815 11.3096 5.00758C11.0162 4.69702 10.6577 4.54991 10.2338 4.54991C9.80995 4.54991 9.45105 4.70519 9.15761 5.00758C8.86417 5.31815 8.71742 5.68593 8.71742 6.11092C8.71742 6.5359 8.86417 6.89549 9.15761 7.18971C9.45105 7.48393 9.80995 7.63105 10.2338 7.63105C10.6577 7.63105 11.0162 7.48393 11.3096 7.18971C11.603 6.8954