  const board = document.getElementById('store-board');
  if (!selection?.outbound) {
    board.innerHTML = '<p class="checkout-lead">No encontramos tu selección de vuelos. Vuelve a elegir tus tarifas.</p>';
  } else {
    const adults = Math.max(1, selection.adults || 1);
    const paxChip = document.getElementById('store-pax-chip');
    if (paxChip) {
      paxChip.innerHTML = `Adulto 1 <span>Pasajero (1 de ${adults + (selection.children || 0)})</span>`;
    }

    const placeEl = document.getElementById('store-cars-place');
    const datesEl = document.getElementById('store-cars-dates');
    if (placeEl) {
      placeEl.textContent = `Aeropuerto · ${selection.to?.city || selection.to?.code || 'Destino'}`;
    }
    if (datesEl) {
      const d1 = selection.depart || '';
      const d2 = selection.returnDate || selection.depart || '';
      datesEl.textContent = `${d1}${selection.trip === 'roundtrip' && d2 ? ` - ${d2}` : ''}`;
    }

    function bagExtras() {
      const cabin = cabinOpts.find((c) => c.id === state.cabin);
      return (
        Number(cabin?.price || 0) +
        Number(state.holdCount || 0) * holdBagPrice +
        Number(state.specialCount || 0) * specialBagPrice
      );
    }

    function carExtras() {
      if (!state.selectedCarId) return 0;
      return Number(state.selectedCarPrice || cars.find((c) => c.id === state.selectedCarId)?.price || 0);
    }

    function flightDetail() {
      const out = selection.outbound?.flight;
      const back = selection.inbound?.flight;
      if (!out) return '<p>Sin vuelos seleccionados.</p>';
      let html = `<p><strong>${selection.from?.city || ''} → ${selection.to?.city || ''}</strong></p>
        <p>${out.depart || ''} – ${out.arrive || ''} · ${out.duration || ''} · ${out.stops || 'Directo'}</p>
        <p>${money(selection.outbound?.price || 0)} por pasajero</p>`;
      if (selection.trip === 'roundtrip' && back) {
        html += `<p class="pax-sum-gap"><strong>${selection.to?.city || ''} → ${selection.from?.city || ''}</strong></p>
          <p>${back.depart || ''} – ${back.arrive || ''} · ${back.duration || ''} · ${back.stops || 'Directo'}</p>
          <p>${money(selection.inbound?.price || 0)} por pasajero</p>`;
      }
      return html;
    }

    function seatDetail() {
      const parts = [];
      if (seats?.outbound?.id) parts.push(`Ida: asiento ${seats.outbound.id} (${money(seats.outbound.price || 0)})`);
      if (seats?.inbound?.id) parts.push(`Vuelta: asiento ${seats.inbound.id} (${money(seats.inbound.price || 0)})`);
      return parts.length ? parts.map((p) => `<p>${p}</p>`).join('') : '<p>Sin asientos seleccionados.</p>';
    }

    function bagDetail() {
      const cabin = cabinOpts.find((c) => c.id === state.cabin);
      return `<p>${cabin?.title || 'Bolso o mochila incluida'}</p>
        <p>Bodega 23 kg × ${Number(state.holdCount || 0)}</p>
        <p>Equipaje especial × ${Number(state.specialCount || 0)}</p>`;
    }

    function summaryRow(id, label, value, detailHtml, iconKey, opts = {}) {
      const open = openSummary === id;
      const isFinal = Boolean(opts.final);
      return `
        <div class="pax-sum-row${open ? ' is-open' : ''}${isFinal ? ' is-final' : ''}" data-sum="${id}">
          <button type="button" class="pax-sum-row__btn" data-sum-toggle="${id}" aria-expanded="${open ? 'true' : 'false'}">
            <span class="pax-sum-row__ico" aria-hidden="true">${SUM_ICONS[iconKey] || ''}</span>
            <span class="pax-sum-row__copy">
              <span class="pax-sum-row__label">${label}</span>
              <span class="pax-sum-row__amount">${value}</span>
              ${isFinal ? '<span class="pax-sum-row__taxes">Incluye tasas, cargos e impuestos</span>' : ''}
            </span>
            <span class="pax-sum-row__chev" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="24" height="24"><path fill="currentColor" d="M27.5509 7.7749L16.001 19.3599L4.45097 7.7749L2.00098 10.2249L16.001 24.2249L30.001 10.2249L27.5509 7.7749Z"/></svg>
            </span>
          </button>
          <div class="pax-sum-row__detail" ${open ? '' : 'hidden'}>${detailHtml || '<p>Sin detalle adicional.</p>'}</div>
        </div>
      `;
    }

    function renderDetail() {
      const extrasSeats = seatExtras(seats, selection);
      const extrasBags = bagExtras();
      const extrasCars = carExtras();
      const flightsBefore = tripBase(selection, false);
      const flights = tripBase(selection, true);
      const totalBefore = flightsBefore + extrasSeats + extrasBags + extrasCars;
      const total = flights + extrasSeats + extrasBags + extrasCars;
      const body = document.getElementById('store-detail-body');
      if (!body) return;
      body.innerHTML = `
        ${summaryRow('flights', 'Vuelos', totalMoney(flightsBefore, flights), flightDetail(), 'flights')}
        ${summaryRow('seats', 'Asientos', money(extrasSeats), seatDetail(), 'seats')}
        ${summaryRow('bags', 'Equipaje', money(extrasBags), bagDetail(), 'bags')}
        ${summaryRow('final', 'Precio final', totalMoney(totalBefore, total), '<p>Incluye tasas, cargos e impuestos.</p>', 'final', { final: true })}
      `;
    }

    function setDetailOpen(open) {
      const drawer = document.getElementById('store-detail-drawer');
      const toggle = document.getElementById('store-price-toggle');
      if (!drawer) return;
      detailOpen = open;
      if (drawer.parentElement !== document.body) document.body.append(drawer);
      if (open) {
        renderDetail();
        drawer.removeAttribute('hidden');
        void drawer.offsetWidth;
        drawer.classList.add('is-open');
      } else {
        drawer.classList.remove('is-open');
        window.setTimeout(() => {
          if (!detailOpen) drawer.setAttribute('hidden', '');
        }, 300);
      }
      toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle?.classList.toggle('is-open', open);
      document.body.classList.toggle('is-store-detail-open', open);
    }

    function updateTotals() {
      const extras = seatExtras(seats, selection) + bagExtras() + carExtras();
      const totalBefore = tripBase(selection, false) + extras;
      const total = tripBase(selection, true) + extras;
      const el = document.getElementById('store-final-price');
      if (el) el.innerHTML = totalMoney(totalBefore, total);
      sessionStorage.setItem(STORE_KEY, JSON.stringify(state));
      if (detailOpen) renderDetail();
    }

    function syncCarCards() {
      document.querySelectorAll('.store-car-card').forEach((card) => {
        const selected = card.dataset.car === state.selectedCarId;
        card.classList.toggle('is-selected', selected);
        const cta = card.querySelector('[data-car-detail]');
        if (cta) cta.textContent = selected ? 'Seleccionado' : 'Ver detalle';
      });
    }

    function closeCarModal() {
      const modal = document.getElementById('store-car-modal');
      modal?.classList.add('hidden');
      modal?.setAttribute('hidden', '');
      document.body.classList.remove('is-store-car-modal-open');
      detailCarId = null;
    }

    function openCarModal(carId) {
      const car = cars.find((c) => c.id === carId);
      const body = document.getElementById('store-car-modal-body');
      const modal = document.getElementById('store-car-modal');
      const selectBtn = document.getElementById('store-car-modal-select');
      if (!car || !body || !modal) return;
      detailCarId = car.id;
      const transmission = car.transmission === 'A' ? 'Automática' : 'Manual';
      body.innerHTML = `
        <div class="store-car-modal__hero">
          <img src="${car.image}" alt="${car.name}" width="360" height="200" />
          <img class="store-car-modal__vendor" src="${car.vendorLogo}" alt="${car.vendor}" height="22" />
        </div>
        <p class="store-car-modal__cat">${car.category}</p>
        <h3>${car.name} <span>o similar</span></h3>
        <div class="store-car-modal__specs">
          <span>${car.seats} asientos</span>
          <span>${car.bags} maletas</span>
          <span>${car.doors} puertas</span>
          <span>${transmission}</span>
          <span>${car.fuel}</span>
        </div>
        <div class="store-car-modal__miles">Acumula ${Number(car.miles).toLocaleString('es-PE')} Millas LATAM Pass</div>
        <strong class="store-car-modal__price">${money(car.price)}</strong>
        <p class="store-car-modal__pay">Paga solo al recoger · Sin cargo si cancelas a tiempo</p>
        <ul class="store-car-modal__includes">
          ${(car.includes || []).map((item) => `<li>${item}</li>`).join('')}
        </ul>
      `;
      if (selectBtn) {
        selectBtn.textContent = state.selectedCarId === car.id ? 'Quitar selección' : 'Seleccionar este auto';
      }
      modal.classList.remove('hidden');
      modal.removeAttribute('hidden');
      document.body.classList.add('is-store-car-modal-open');
    }

    function syncCabinUI() {
      document.querySelectorAll('.store-cabin-card').forEach((card) => {
        const selected = card.dataset.cabin === state.cabin;
        card.classList.toggle('is-selected', selected);
        card.setAttribute('aria-checked', selected ? 'true' : 'false');
      });
    }

    function syncHoldUI() {
      const countEl = document.getElementById('store-hold-count');
      const minus = document.getElementById('store-hold-minus');
      if (countEl) countEl.textContent = String(state.holdCount);
      if (minus) minus.disabled = state.holdCount <= 0;
    }

    function syncSpecialUI() {
      const countEl = document.getElementById('store-special-count');
      const minus = document.getElementById('store-special-minus');
      if (countEl) countEl.textContent = String(state.specialCount);
      if (minus) minus.disabled = state.specialCount <= 0;
    }

    function syncCta() {
      const cta = document.getElementById('store-next-step');
      if (!cta) return;
      const ready = currentSection !== 'baggage';
      cta.textContent = 'Ir al siguiente paso';
      cta.classList.toggle('is-disabled', !ready);
      cta.setAttribute('aria-disabled', ready ? 'false' : 'true');
    }

    function openSection(id) {
      currentSection = id;
      document.querySelectorAll('.store-accordion').forEach((acc) => {
        const open = acc.dataset.section === id;
        acc.classList.toggle('is-open', open);
        const body = acc.querySelector('.store-accordion__body');
        const btn = acc.querySelector('[data-accordion-toggle]');
        if (body) {
          if (open) body.removeAttribute('hidden');
          else body.setAttribute('hidden', '');
        }
        btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      syncCta();
      if (id === 'cars') {
        document.getElementById('store-cars-body')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function goPassengers() {
      sessionStorage.setItem(STORE_KEY, JSON.stringify(state));
      const search = selection.search || '';
      const qs = search.startsWith('?') ? search : search ? `?${search}` : '';
      window.location.href = `/pasajeros${qs}`;
    }

    document.querySelectorAll('[data-accordion-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => openSection(btn.dataset.accordionToggle));
    });

    document.getElementById('store-next-service')?.addEventListener('click', () => openSection('cars'));

    document.getElementById('store-next-step')?.addEventListener('click', () => {
      if (currentSection === 'baggage') return;
      goPassengers();
    });

    document.getElementById('store-price-toggle')?.addEventListener('click', () => setDetailOpen(!detailOpen));
    document.getElementById('store-detail-close')?.addEventListener('click', () => setDetailOpen(false));
    document.getElementById('store-detail-backdrop')?.addEventListener('click', () => setDetailOpen(false));
    document.getElementById('store-detail-body')?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-sum-toggle]');
      if (!btn) return;
      openSummary = openSummary === btn.dataset.sumToggle ? '' : btn.dataset.sumToggle;
      renderDetail();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && detailOpen) setDetailOpen(false);
    });

    document.getElementById('store-same-flights')?.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      state.sameAllFlights = !state.sameAllFlights;
      btn.classList.toggle('is-on', state.sameAllFlights);
      btn.setAttribute('aria-pressed', state.sameAllFlights ? 'true' : 'false');
      updateTotals();
    });

    document.getElementById('store-cabin-options')?.addEventListener('click', (e) => {
      const card = e.target.closest('.store-cabin-card');
      if (!card) return;
      state.cabin = card.dataset.cabin;
      syncCabinUI();
      updateTotals();
    });

    document.getElementById('store-hold-plus')?.addEventListener('click', () => {
      state.holdCount = Math.min(5, state.holdCount + 1);
      syncHoldUI();
      updateTotals();
    });
    document.getElementById('store-hold-minus')?.addEventListener('click', () => {
      state.holdCount = Math.max(0, state.holdCount - 1);
      syncHoldUI();
      updateTotals();
    });

    document.getElementById('store-special-toggle')?.addEventListener('click', () => {
      const panel = document.getElementById('store-special-panel');
      const btn = document.getElementById('store-special-toggle');
      const wrap = document.getElementById('store-special-wrap');
      const open = panel?.classList.contains('hidden');
      panel?.classList.toggle('hidden', !open);
      wrap?.classList.toggle('is-open', !!open);
      if (open) panel?.removeAttribute('hidden');
      else panel?.setAttribute('hidden', '');
      btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    document.getElementById('store-special-plus')?.addEventListener('click', () => {
      state.specialCount = Math.min(5, state.specialCount + 1);
      syncSpecialUI();
      updateTotals();
    });
    document.getElementById('store-special-minus')?.addEventListener('click', () => {
      state.specialCount = Math.max(0, state.specialCount - 1);
      syncSpecialUI();
      updateTotals();
    });

    document.getElementById('store-cars-grid')?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-car-detail]');
      if (!btn) return;
      openCarModal(btn.dataset.carDetail);
    });

    document.getElementById('store-car-modal-close')?.addEventListener('click', closeCarModal);
    document.getElementById('store-car-modal-backdrop')?.addEventListener('click', closeCarModal);
    document.getElementById('store-car-modal-select')?.addEventListener('click', () => {
      if (!detailCarId) return;
      if (state.selectedCarId === detailCarId) {
        state.selectedCarId = null;
        state.selectedCarPrice = 0;
      } else {
        const car = cars.find((c) => c.id === detailCarId);
        state.selectedCarId = detailCarId;
        state.selectedCarPrice = Number(car?.price || 0);
      }
      syncCarCards();
      updateTotals();
      closeCarModal();
    });

    document.getElementById('store-all-cars')?.addEventListener('click', () => {
      openCarModal(cars[0]?.id);
    });

    openSection('baggage');
    syncCabinUI();
    syncHoldUI();
    syncSpecialUI();
    syncCarCards();
    updateTotals();
  }
</script>
