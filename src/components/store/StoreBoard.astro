---
import { cabinOptions, carPartners, holdBagKg, holdBagPrice, specialBagPrice, storeCars } from '../../data/storeData';
import { PORCENTAJE_DESCUENTO } from 'astro:env/client';

const carsJson = JSON.stringify(storeCars);
const cabinJson = JSON.stringify(cabinOptions);
---

<div class="store-layout" id="store-board">
  <div class="store-layout__main">
    <h1 class="store-title">Personaliza tu viaje</h1>

    <div class="store-sections">
      <article class="store-accordion is-open" data-section="baggage">
        <button type="button" class="store-accordion__head" data-accordion-toggle="baggage" aria-expanded="true">
          <span class="store-accordion__label">
            <svg class="store-accordion__ico" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 4h10v3h5v21H6V7h5V4zm2 2v1h6V6h-6zm-5 4v15h16V10H8zm3 3h2v9h-2v-9zm8 0h2v9h-2v-9z"/></svg>
            Equipaje
          </span>
          <span class="store-accordion__meta">
            <span class="store-step-pill">1 de 2</span>
            <svg class="store-accordion__chev" viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M27.55 7.77 16 19.36 4.45 7.77 2 10.22 16 24.22 30 10.22 27.55 7.77Z"/></svg>
          </span>
        </button>

        <div class="store-accordion__body" id="store-baggage-body">
          <h3 class="store-baggage__lead">Compra tu equipaje ahora y paga menos que en aeropuerto</h3>

          <div class="store-toggle-row">
            <span class="store-toggle-row__label">
              <img src="/images/tienda-assets/plane.svg" alt="" width="24" height="24" />
              Agregar el mismo equipaje en todos los vuelos
            </span>
            <button type="button" class="store-switch is-on" id="store-same-flights" aria-pressed="true" aria-label="Agregar el mismo equipaje en todos los vuelos">
              <span class="store-switch__knob"></span>
            </button>
          </div>

          <div class="store-pax-chip" id="store-pax-chip">Adulto 1 <span>Pasajero (1 de 1)</span></div>

          <div class="store-block">
            <div class="store-block__head">Selecciona qué <strong>llevarás en cabina</strong></div>
            <div class="store-cabin-grid" id="store-cabin-options" role="radiogroup" aria-label="Equipaje en cabina">
              {cabinOptions.map((opt, i) => (
                <button
                  type="button"
                  class={`store-cabin-card${i === 0 ? ' is-selected' : ''}`}
                  data-cabin={opt.id}
                  data-price={opt.price}
                  role="radio"
                  aria-checked={i === 0 ? 'true' : 'false'}
                >
                  <div class="store-cabin-card__visual" aria-hidden="true">
                    <img
                      src={opt.id === 'personal' ? '/images/tienda-assets/bag-personal.svg' : '/images/tienda-assets/bag-cabin.svg'}
                      alt=""
                      width="79"
                      height="63"
                    />
                  </div>
                  <div class="store-cabin-card__copy">
                    <strong>{opt.title}</strong>
                    {opt.subtitle ? <span>{opt.subtitle}</span> : null}
                  </div>
                  <div class="store-cabin-card__foot">
                    <span class="store-radio" aria-hidden="true"></span>
                    <span>{opt.priceLabel}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <div class="store-block">
            <div class="store-block__head">¿Agregas equipaje de bodega?</div>
            <div class="store-hold-row">
              <div class="store-hold-row__left">
                <img src="/images/tienda-assets/bag-hold.svg" alt="" width="40" height="53" />
                <div>
                  <strong>{holdBagKg} kg</strong>
                  <span>USD {holdBagPrice.toFixed(2).replace('.', ',')}</span>
                </div>
              </div>
              <div class="store-qty" data-qty>
                <button type="button" class="store-qty__btn" id="store-hold-minus" aria-label="Eliminar un equipaje de bodega de 23 kg" disabled>−</button>
                <span id="store-hold-count">0</span>
                <button type="button" class="store-qty__btn store-qty__btn--add" id="store-hold-plus" aria-label="Agregar un equipaje de bodega de 23 kg">+</button>
              </div>
            </div>
          </div>

          <div class="store-special-wrap" id="store-special-wrap">
            <button type="button" class="store-special" id="store-special-toggle" aria-expanded="false">
              <span class="store-special__left">
                <img src="/images/tienda-assets/bag-special.svg" alt="" width="40" height="40" />
                <span>
                  <strong>Equipaje especial</strong>
                  <small>Deportivo, musical y audiovisual</small>
                </span>
              </span>
              <svg class="store-special__chev" viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path fill="#e8114b" d="M27.55 7.77 16 19.36 4.45 7.77 2 10.22 16 24.22 30 10.22 27.55 7.77Z"/></svg>
            </button>
            <div class="store-special__panel hidden" id="store-special-panel" hidden>
              <div class="store-special__offer">
                <strong class="store-special__price">USD {specialBagPrice.toFixed(2).replace('.', ',')}</strong>
                <div class="store-qty" data-qty>
                  <button type="button" class="store-qty__btn" id="store-special-minus" aria-label="Eliminar un equipaje especial" disabled>−</button>
                  <span id="store-special-count">0</span>
                  <button type="button" class="store-qty__btn store-qty__btn--add" id="store-special-plus" aria-label="Agregar un equipaje especial">+</button>
                </div>
              </div>
              <a
                class="store-special__link"
                href="https://www.latamairlines.com/pe/es/experiencia-latam/equipaje"
                target="_blank"
                rel="noopener"
              >
                Ver características
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M9.5 2H14v4.5h-1.5V4.56L7.53 9.53 6.47 8.47l4.97-4.97H9.5V2zM3 3.5h4V5H4.5v6.5H11V9H12.5v4.5h-9V3.5z"/></svg>
              </a>
            </div>
          </div>

          <div class="store-info">
            <p><strong>Equipaje en cabina:</strong> podría ser enviado a bodega si no hay espacio en cabina, al momento de embarcar.</p>
            <p><strong>Equipaje de bodega:</strong> pagarás un costo extra si supera el peso máximo que compraste. Asegúrate de agregar el equipaje necesario. <a href="https://www.latamairlines.com/pe/es/experiencia-latam/equipaje" target="_blank" rel="noopener">Más información</a></p>
          </div>

          <a class="store-link" href="https://www.latamairlines.com/pe/es/experiencia-latam/equipaje" target="_blank" rel="noopener">Revisa las medidas y condiciones de tu equipaje →</a>

          <div class="store-note">
            Si necesitas acceder al beneficio de equipaje gratis asociado a tu categoría o tarjeta de crédito, agrega tu número de pasajero frecuente en los datos del pasajero.
          </div>

          <button type="button" class="store-next-service" id="store-next-service">Ir al siguiente servicio</button>
        </div>
      </article>

      <article class="store-accordion" data-section="cars">
        <button type="button" class="store-accordion__head" data-accordion-toggle="cars" aria-expanded="false">
          <span class="store-accordion__label">
            <svg class="store-accordion__ico" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M7 20h18l-1.5-6H8.5L7 20zm2.5-8h13l1.2 4.8H8.3L9.5 12zM9 22a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm14 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></svg>
            Carro
            <span class="store-badge">Nuevo</span>
          </span>
          <span class="store-accordion__meta">
            <span class="store-step-pill">2 de 2</span>
            <svg class="store-accordion__chev" viewBox="0 0 32 32" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M27.55 7.77 16 19.36 4.45 7.77 2 10.22 16 24.22 30 10.22 27.55 7.77Z"/></svg>
          </span>
        </button>

        <div class="store-accordion__body" id="store-cars-body" hidden>
          <div class="store-cars-banner">
            <div class="store-cars-banner__copy">
              <span class="store-badge store-badge--light">Nuevo</span>
              <p class="store-cars-banner__kicker">¡Reserva TU COCHE AHORA!</p>
              <h3>Asegura el precio antes de que suba <strong>PAGA SOLO AL RECOGER</strong></h3>
              <p class="store-cars-banner__sub">Sin ningún cargo en tu tarjeta si cambias de opinión</p>
            </div>
          </div>

          <div class="store-cars-search">
            <div class="store-cars-search__info">
              <strong id="store-cars-place">Aeropuerto de destino</strong>
              <span id="store-cars-dates">Fechas del viaje</span>
              <span>Edad del conductor 30 - 69</span>
            </div>
            <button type="button" class="store-cars-edit" id="store-cars-edit">Editar</button>
          </div>

          <div class="store-cars-grid" id="store-cars-grid">
            {storeCars.map((car) => (
              <article class="store-car-card" data-car={car.id}>
                <h4>{car.name} <span>o similar</span></h4>
                <img src={car.image} alt={`${car.name} image`} width="240" height="150" loading="lazy" />
                <div class="store-car-card__specs">
                  <span>{car.seats} asientos</span>
                  <span>{car.bags} maletas</span>
                  <span>{car.transmission}</span>
                </div>
                <div class="store-car-card__miles">Acumula {car.miles.toLocaleString('es-PE')} Millas LATAM Pass</div>
                <img class="store-car-card__vendor" src={car.vendorLogo} alt={`Logotipo de ${car.vendor}`} height="20" />
                <strong class="store-car-card__price">USD {car.price.toFixed(2).replace('.', ',')}</strong>
                <button type="button" class="store-car-card__cta" data-car-detail={car.id}>Ver detalle</button>
              </article>
            ))}
          </div>

          <div class="store-cars-foot">
            <div>
              <p>Compara vehículos y encuentra la mejor oferta para tu viaje</p>
              <div class="store-partners">
                {carPartners.map((p) => (
                  <img src={p.logo} alt={`Logotipo de ${p.name}`} height="18" />
                ))}
              </div>
            </div>
            <div class="store-cars-pager">
              <button type="button" disabled aria-label="Anterior">‹</button>
              <span>1 / 34</span>
              <button type="button" aria-label="Siguiente">›</button>
              <button type="button" class="store-link-btn" id="store-all-cars">Ver todos los autos</button>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <aside class="store-aside" id="store-bar" aria-label="Resumen y confirmación de la compra.">
    <div class="store-aside__spacer" aria-hidden="true"></div>
    <div class="store-aside__footer">
      <button type="button" class="store-bar__price" id="store-price-toggle" aria-expanded="false">
        <span class="store-bar__price-label">
          Precio final
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true">
            <path fill="currentColor" d="M4.45004 24.2251L16 12.6401L27.55 24.2251L30 21.7751L16 7.77511L2 21.7751L4.45004 24.2251Z"/>
          </svg>
        </span>
        <strong id="store-final-price">USD 0,00</strong>
      </button>
      <button type="button" class="checkout-continue store-bar__cta is-disabled" id="store-next-step" aria-disabled="true">Ir al siguiente paso</button>
    </div>
  </aside>
</div>

<div class="store-detail-drawer" id="store-detail-drawer" hidden>
  <button type="button" class="store-detail-drawer__backdrop" id="store-detail-backdrop" aria-label="Cerrar detalle de viaje"></button>
  <aside class="store-detail-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="store-detail-title">
    <header class="store-detail-drawer__head">
      <h2 id="store-detail-title">Detalle de viaje</h2>
      <button type="button" class="store-detail-drawer__close" id="store-detail-close" aria-label="Cerrar">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32" width="16" height="16" aria-hidden="true">
          <path fill="currentColor" d="M24.4999 27.2075L15.9999 18.8115L7.49992 27.2075L4.79199 24.5L13.188 15.9996L4.79199 7.49998L7.49992 4.99998L15.9801 13.2075L24.4999 4.81146L27.188 7.49998L18.792 15.9996L27.188 24.5L24.4999 27.2075Z"/>
        </svg>
      </button>
    </header>
    <div class="store-detail-drawer__body" id="store-detail-body"></div>
  </aside>
</div>

<div class="store-car-modal hidden" id="store-car-modal" hidden>
  <button type="button" class="store-car-modal__backdrop" id="store-car-modal-backdrop" aria-label="Cerrar detalle"></button>
  <div class="store-car-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="store-car-modal-title">
    <header class="store-car-modal__head">
      <h2 id="store-car-modal-title">Detalle del vehículo</h2>
      <button type="button" class="store-car-modal__close" id="store-car-modal-close" aria-label="Cerrar">×</button>
    </header>
    <div class="store-car-modal__body" id="store-car-modal-body"></div>
    <footer class="store-car-modal__foot">
      <button type="button" class="checkout-continue store-car-modal__cta" id="store-car-modal-select">Seleccionar este auto</button>
    </footer>
  </div>
</div>

<script define:vars={{ carsJson, cabinJson, holdBagPrice, specialBagPrice, PORCENTAJE_DESCUENTO }}>
  const STORAGE_KEY = 'latam-checkout-selection';
  const SEATS_KEY = 'latam-seat-selection';
  const STORE_KEY = 'latam-store-selection';
  const cars = JSON.parse(carsJson);
  const cabinOpts = JSON.parse(cabinJson);
  const discountPct = Number(PORCENTAJE_DESCUENTO) || 0;

  function money(value) {
    return `USD ${Number(value).toFixed(2).replace('.', ',')}`;
  }

  function ticketAfterDiscount(original) {
    const base = Number(original) || 0;
    if (!(discountPct > 0)) return Math.round(base * 100) / 100;
    return Math.round(base * (1 - Math.min(100, discountPct) / 100) * 100) / 100;
  }

  function totalMoney(before, after) {
    if (!(discountPct > 0) || Math.abs(before - after) < 0.005) return money(after);
    return `<span class="ticket-price"><span class="ticket-price__was">${money(before)}</span><span class="ticket-price__now">${money(after)}</span></span>`;
  }

  function readJson(key, fallback) {
    try {
      return JSON.parse(sessionStorage.getItem(key) || 'null') ?? fallback;
    } catch {
      return fallback;
    }
  }

  function tripBase(selection, discounted = true) {
    const outRaw = Number(selection?.outbound?.price || 0);
    const backRaw = Number(selection?.inbound?.price || 0);
    const out = discounted ? ticketAfterDiscount(outRaw) : outRaw;
    const back = discounted ? ticketAfterDiscount(backRaw) : backRaw;
    const pax = Math.max(1, (selection?.adults || 0) + (selection?.children || 0) + (selection?.infants || 0));
    return (out + back) * pax;
  }

  function seatExtras(seats, selection) {
    let total = 0;
    if (seats?.outbound?.price) total += Number(seats.outbound.price);
    if (selection?.trip === 'roundtrip' && seats?.inbound?.price) total += Number(seats.inbound.price);
    return total;
  }

  const selection = readJson(STORAGE_KEY, null);
  const seats = readJson(SEATS_KEY, { outbound: null, inbound: null });
  const state = readJson(STORE_KEY, {
    cabin: 'personal',
    holdCount: 0,
    specialCount: 0,
    sameAllFlights: true,
    selectedCarId: null,
    selectedCarPrice: 0,
  });
  if (typeof state.specialCount !== 'number') state.specialCount = 0;
  if (state.selectedCarId === undefined) state.selectedCarId = null;
  if (typeof state.selectedCarPrice !== 'number') state.selectedCarPrice = 0;

  let currentSection = 'baggage';
  let detailCarId = null;
  let detailOpen = false;
  let openSummary = '';

  const SUM_ICONS = {
    flights: `<svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M15.0369 17.8496C15.2231 17.7789 15.4235 17.8284 15.624 17.9839C15.7672 18.1182 15.8029 18.3019 15.7313 18.5352L13.7912 23.907L15.9389 23.3911C16.1251 23.3204 16.2397 23.2567 16.2826 23.1861L20.6497 15.9977C20.7428 15.8563 20.8358 15.7786 20.9289 15.7574L27.1717 13.5309C27.816 13.3047 28.2957 12.9796 28.6107 12.5555C28.9257 12.1314 28.9829 11.6719 28.804 11.1701C28.7539 11.0358 28.6823 10.8874 28.5749 10.7248C28.4675 10.5623 28.3028 10.4279 28.0737 10.3149C27.8446 10.2018 27.5153 10.1523 27.1001 10.1594C26.6849 10.1735 26.1336 10.2937 25.4392 10.5198L20.8287 12.1597C20.6926 12.2021 20.5494 12.2021 20.4134 12.1455C20.2774 12.089 20.1844 11.99 20.1342 11.8557C20.0841 11.7002 20.0984 11.5518 20.17 11.4246C20.2416 11.2973 20.3419 11.2125 20.485 11.1701L25.0955 9.53029C27.6156 8.6609 29.1834 9.09913 29.8134 10.8308C30.021 11.4034 30.0568 11.9193 29.9136 12.3858C29.7776 12.8523 29.4984 13.2694 29.0832 13.6369C28.668 14.0045 28.1453 14.3013 27.5225 14.5275L21.4873 16.6833L17.1847 23.7727C17.0487 24.0201 16.7193 24.2392 16.211 24.423L13.4046 25.0733C13.0753 25.144 12.839 25.0733 12.6744 24.8683C12.5097 24.6633 12.4811 24.423 12.567 24.1474L14.3353 19.2208L10.14 20.6627C8.98743 21.0515 7.90642 21.0868 6.89698 20.7617C5.88753 20.4436 5.11433 19.8004 4.55592 18.8462L2.16474 14.6689C1.84258 14.0751 1.99292 13.6652 2.61577 13.439L4.45568 12.7887C4.82795 12.6544 5.1716 12.711 5.49377 12.9584L8.78696 15.3898L12.9106 13.8843L7.67013 8.8164C7.51263 8.61142 7.44105 8.39229 7.46253 8.16611C7.53412 7.93993 7.68447 7.77736 7.91356 7.68548H7.94935L10.5839 6.96453C10.9061 6.85144 11.2283 6.88677 11.5504 7.07055L16.9985 10.018C17.1346 10.0887 17.2205 10.1947 17.2563 10.3431C17.292 10.4916 17.2706 10.6259 17.2061 10.739C17.1345 10.8732 17.0343 10.9651 16.8983 11.0146C16.7623 11.0641 16.6191 11.0499 16.483 10.9793L11.0349 8.00356C11.0135 7.98235 10.9705 7.98235 10.8989 8.00356L8.9229