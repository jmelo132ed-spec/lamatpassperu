---
import LandingTicketButton from './LandingTicketButton.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<div class="landing-sticky">
  <p>Hasta <strong>42% dcto.</strong> en vuelos desde Perú</p>
  <LandingTicketButton href={href} label={label} variant="primary" />
</div>

<style>
  .landing-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: #10004f;
    color: #fff;
    box-shadow: 0 -8px 24px rgba(16, 0, 79, 0.2);
  }

  p {
    margin: 0;
    font-size: 14px;
  }

  .landing-sticky :global(.landing-btn) {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 15px;
    animation: none;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    p {
      font-size: 13px;
    }
  }
</style>
