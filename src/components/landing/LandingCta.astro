---
import LandingTicketButton from './LandingTicketButton.astro';

interface Props {
  title: string;
  text: string;
  primaryCta: string;
  image: string;
  ticketsHref: string;
}

const { title, text, primaryCta, image, ticketsHref } = Astro.props;
---

<section class="landing-cta" aria-labelledby="landing-cta-title">
  <img class="landing-cta__bg" src={image} alt="" aria-hidden="true" loading="lazy" />
  <div class="landing-cta__shade" aria-hidden="true"></div>
  <div class="container-latam landing-cta__inner">
    <p class="landing-cta__badge">Hasta 42% dcto.</p>
    <h2 id="landing-cta-title">{title}</h2>
    <p>{text}</p>
    <LandingTicketButton href={ticketsHref} label={primaryCta} variant="white" />
  </div>
</section>

<style>
  .landing-cta {
    position: relative;
    overflow: hidden;
    color: #fff;
    padding: 72px 0;
  }

  .landing-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .landing-cta__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(16, 0, 79, 0.88), rgba(232, 17, 75, 0.72));
  }

  .landing-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .landing-cta__badge {
    display: inline-block;
    margin: 0 0 12px;
    background: #fff;
    color: #e8114b;
    font-weight: 600;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 999px;
  }

  h2 {
    margin: 0 0 12px;
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 600;
  }

  p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 640px) {
    .landing-cta__inner :global(.landing-btn) {
      width: 100%;
    }
  }
</style>
